# Copy to .env at the repository root. Never commit real credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/?appName=faminder
MONGODB_DB=faminder
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
PORT=3001
ADMIN_ORIGINS=http://localhost:5173
NODE_ENV=development
# Tablet: put this in apps/tablet/.env; use the computer's LAN IP for a real device.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api
